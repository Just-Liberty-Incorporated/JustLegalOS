{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JustLegal OS",
  "version": "0.1.0",
  "identifier": "me.justlegal.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "JustLegal OS",
        "width": 1180,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://api.usaspending.gov https://npiregistry.cms.hhs.gov;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2026 Joshua Abrams / Just Liberty Inc.",
    "category": "Productivity",
    "shortDescription": "JustLegal OS — Private, local-first legal document formatting and court assembly desktop client.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "signingIdentity": null,
      "entitlements": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Just-Liberty-Incorporated/JustLegalOS/releases/latest/download/latest.json",
        "https://github.com/unlimitedinfinit/JustLegalOS/releases/latest/download/latest.json",
        "https://github.com/unlimitedinfinit/OpenSeason/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}